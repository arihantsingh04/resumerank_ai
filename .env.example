# ResumeRank configuration template.
#   1) Copy this file to `.env` (which is git-ignored):   copy .env.example .env
#   2) Fill in only what you need. Blank values use the default shown in the comment above each key.
# NEVER put real secrets in this file: it is committed to git.

# ── Gemini (optional: without a key the app still scores resumes with rule-based tips) ──
# Get a key at https://aistudio.google.com/apikey  (free-tier inputs may be used by Google to improve products)
GEMINI_API_KEY=
# default: gemini-3.5-flash-lite (reads job descriptions)
GEMINI_PARSE_MODEL=
# default: gemini-3.5-flash-lite (writes the AI coaching)
GEMINI_RERANK_MODEL=
# default: gemini-flash-latest (used when the main model is busy)
GEMINI_FALLBACK_MODEL=
# default: 10 (max Gemini calls per minute from this server)
GEMINI_RPM=
# default: 20 (seconds per Gemini attempt; at most 2 attempts)
GEMINI_TIMEOUT_S=

# ── Abuse protection (no logins, so limits are per visitor IP and global) ──
# default: 400 (Gemini calls per day for the whole site)
GEMINI_DAILY_BUDGET=
# default: 15 (AI-coached checks per visitor IP per day)
AI_CHECKS_PER_IP_PER_DAY=
# default: 10 (checks per visitor IP per minute)
CHECKS_PER_MINUTE_PER_IP=
# default: 4 (checks processed at the same time)
MAX_CONCURRENT_CHECKS=
# default: 4 (MB per uploaded file)
MAX_UPLOAD_MB=
# default: empty = use the connection address. Set to x-real-ip ONLY behind a proxy that overwrites it (Vercel).
TRUSTED_IP_HEADER=

# ── App ──
# default: development   (production hides /docs and adds HSTS)
ENV=
# default: ./data   (only the embedding-model cache is stored here)
DATA_DIR=
# default: http://localhost:5173   (comma-separated list)
CORS_ORIGINS=

# ── Scoring ──
# default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=
# default: auto   (auto | torch | onnx)
EMBEDDING_BACKEND=
# default: 0.15
SEMANTIC_SIM_LOW=
# default: 0.65
SEMANTIC_SIM_HIGH=
# default: 0.55
SKILL_MATCH_THRESHOLD=
# default: 0.5   (weight of the AI score in the final score)
LLM_BLEND=
